HOST=127.0.0.1
PORT=4320
# DATA_DIR=
# MODEL_CACHE_DIR=
# KOKORO_DTYPE=fp32
# PUBLIC_URL=https://isnn.example.com

# Overtime Desk (/sports)
# SPORTS_TIMEZONE=America/Chicago
# SPORTS_DESK_USER=isaac
# SPORTS_DESK_PASSWORD=
# Windows: hold off idle sleep for as long as the desk server runs.
# SPORTS_KEEP_AWAKE=true
# Public Cloudflare quick-tunnel link, started with the desk (needs SPORTS_DESK_PASSWORD).
# The link changes on every start and is saved to data/tunnel-url.txt.
# SPORTS_QUICK_TUNNEL=true
# SPORTS_CLOUDFLARED=C:\Program Files (x86)\cloudflared\cloudflared.exe
# Local writing and source review through Ollama.
# SPORTS_LLM_URL=http://127.0.0.1:11434
# SPORTS_LLM_API=ollama
# SPORTS_LLM_MODEL=qwen3:4b
# SPORTS_LLM_TIMEOUT_MS=300000
# SPORTS_LLM_API_KEY=
# SPORTS_FEEDS=[{"publisher":"Example Sports Desk","url":"https://example.com/sports/rss"}]
# SPORTS_VOICE=isaac
# SPORTS_TTS_MODEL=
# SPORTS_VOICE_REF=
# Kokoro names (am_michael and the others) remain available when SPORTS_VOICE is not isaac.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# Reading and replying to comments needs youtube.force-ssl on this token, as well as youtube.upload.
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY_STATUS=public
# SPORTS_PUBLISH_ENABLED=false

# ESPN public scoreboard as the evidence source (read-only, opt-in). Unset keeps the fixture adapter.
# SPORTS_EVIDENCE=espn
# SPORTS_ESPN_LEAGUES=nba,ncaab,ncaaf,ncaaw,mlb
# SPORTS_ASSET_CACHE_MB=500
# SPORTS_FOOTAGE_CACHE_MB=2048
# YouTube footage is enabled for live builds. Install with npm run setup:youtube.
# SPORTS_YOUTUBE_FOOTAGE=on
# Optional yt-dlp executable; otherwise uses the project-local Python installation.
# SPORTS_YTDLP=
# SPORTS_PYTHON=python
# SPORTS_ESPN_USER_AGENT=ISNN-Overtime-Desk
