{
  "name": "isnn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ISNN Overtime Desk: an overnight sports newsroom that researches, scripts, renders and publishes a daily multi-sport recap with one Short per segment.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "render:fixture": "node scripts/render-fixture.mjs",
    "preview:thumbnails": "node scripts/preview-thumbnails.mjs",
    "test:editorial:local": "node scripts/test-editorial-chat.mjs",
    "espn:smoke": "node scripts/espn-smoke.mjs",
    "setup:youtube": "node scripts/install-youtube.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "^1.0.10",
    "animejs": "^4.5.0",
    "canvaskit-wasm": "^0.42.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "supertest": "^7.3.1",
    "vite": "^8.3.4"
  }
}
